{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "destination": "https://ybxanime.com",
      "permanent": false
    },
    {
      "source": "/view/:path*",
      "destination": "https://dl.ybxanime.com/view/:path*",
      "permanent": false
    },
    {
      "source": "/f/:path*",
      "destination": "https://dl.ybxanime.com/f/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dl.ybxanime.com/api/:path*"
    }
  ]
}
